# Human template + rationale for the WEB feature's exact-version pin. The actual p2.inf is GENERATED
# by the build (genFeatureP2Inf) from -PevolveIu/-PevolveVersion — this file is documentation + an
# up-to-date input, its literal `requires` below is illustrative.
#
# Web variant pins Evolve's WEB SWT feature group (the web analogue of feat.hybrid), whose version ==
# the Evolve release version (same across Eclipse lines) = the Evolve tag we build against. Confirm the
# exact IU with Mati (assumed dev.equo.swt.evolve.feat.web.feature.group, from <release>/web/p2).
#
# Example after generation (Evolve 0.336.0):
#   requires.1.namespace = org.eclipse.equinox.p2.iu
#   requires.1.name = dev.equo.swt.evolve.feat.web.feature.group
#   requires.1.range = [0.336.0,0.336.0]

requires.1.namespace = org.eclipse.equinox.p2.iu
requires.1.name = dev.equo.swt.evolve.feat.web.feature.group
requires.1.range = [0.0.0,0.0.0]
