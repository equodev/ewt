# Pins the EXACT swt-evolve version this feature was built against, so p2 refuses to
# install onto a product carrying a different Evolve (fail-closed — no blank IDE).
#
# This mirrors swt-evolve's own host requirement generation
# (swt_native/build.gradle.kts:genHostP2Inf, `requires.N.range = [v,v]`).
#
# Q1 — CORRECTED per Mati/CLI (2026-09-16): pin Evolve's SWT-layer FEATURE GROUP, the same unit the
# p2 director installs, NOT the org.eclipse.swt host bundle:
#   @EVOLVE_IU@      = dev.equo.swt.evolve.feat.hybrid.feature.group
#   @EVOLVE_VERSION@ = that feature group's version in the Evolve desktop-hybrid p2 (e.g. matching
#                      the Evolve release the ewt-evolve fragment was built against)
# That feature group is assembled by the CLI-side publishing pipeline (NOT swt-evolve), so its
# version is NOT in any jar we build — the Gradle build takes it via -PevolveVersion, which CI reads
# from Evolve's published desktop-hybrid p2 (the exact repo the director installs from). Pinning it
# exactly means p2 refuses to install onto a product with a different Evolve → a bad refresh fails
# instead of shipping a blank IDE.
#
# Example after substitution:
#   requires.1.name  = dev.equo.swt.evolve.feat.hybrid.feature.group
#   requires.1.range = [<evolveFeatureGroupVersion>,<evolveFeatureGroupVersion>]

requires.1.namespace = org.eclipse.equinox.p2.iu
requires.1.name = @EVOLVE_IU@
requires.1.range = [@EVOLVE_VERSION@,@EVOLVE_VERSION@]
