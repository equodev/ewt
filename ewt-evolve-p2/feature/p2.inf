# Human template + rationale. The actual p2.inf is GENERATED by the build (genFeatureP2Inf) from
# -PevolveIu / -PevolveVersion — this file is documentation + an up-to-date input; the literal values
# below are illustrative.
#
# Pins the EXACT Evolve version so p2 refuses to install onto a mismatched Evolve (fail-closed — no
# blank IDE; a failed refresh keeps the prior working artifact).
#
# We pin **org.eclipse.swt** (Evolve's SWT host), NOT a mode-specific feature group. The addon is
# COMBINED (carries both the desktop and web bundles, one artifact for both modes); feat.hybrid /
# feat.web only exist in their own mode, whereas org.eclipse.swt is the single bundle serving both.
# Its version encodes the Eclipse line (e.g. 3.133.0.v0_336_0-hyb for 2026-03, 3.134.0.v0_336_0-hyb
# for 2026-06), so the p2 repo is published PER LINE; CI passes each line's exact version.
#
# Example after generation (Evolve 0.336 on the 2026-03 line):
#   requires.1.namespace = org.eclipse.equinox.p2.iu
#   requires.1.name = org.eclipse.swt
#   requires.1.range = [3.133.0.v0_336_0-hyb,3.133.0.v0_336_0-hyb]

requires.1.namespace = org.eclipse.equinox.p2.iu
requires.1.name = org.eclipse.swt
requires.1.range = [0.0.0,0.0.0]
