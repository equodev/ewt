<?xml version="1.0" encoding="UTF-8"?>
<feature
      id="dev.equo.ewt.evolve.feature"
      label="EWT to Evolve Integration"
      version="0.1.0.qualifier"
      provider-name="Equo Tech, Inc.">

   <description>
      Embeds EWT (Flutter) widgets in an SWT Evolve surface. Bundles the per-OS
      ewt-evolve fragment and a demo view. This feature is pinned to the EXACT
      SWT Evolve version it was built against (see p2.inf) so p2 refuses to install
      it onto a product carrying a different Evolve — a mismatch fails the patch
      instead of publishing a blank IDE.
   </description>

   <copyright>
      Copyright (c) Equo Tech, Inc.
   </copyright>

   <!--
     Per-platform ewt-evolve fragments (Fragment-Host: org.eclipse.swt, provided by Evolve). Each has
     a distinct Bundle-SymbolicName dev.equo.ewt.evolve.<ws>.<os>.<arch> + Eclipse-PlatformFilter, so
     ONE feature/repo carries every platform and p2 installs only the matching one (the fragment's
     content is per-OS — it carries the native combined bundle). The os/ws/arch attributes here scope
     each entry so a non-matching platform's requirement is dropped at install (a partial repo still
     installs on the platforms it does carry). version="0.0.0" => resolved at publish time.
   -->
   <plugin id="dev.equo.ewt.evolve.gtk.linux.x86_64"
         os="linux" ws="gtk" arch="x86_64"
         download-size="0" install-size="0" version="0.0.0" fragment="true" unpack="false"/>
   <plugin id="dev.equo.ewt.evolve.win32.win32.x86_64"
         os="win32" ws="win32" arch="x86_64"
         download-size="0" install-size="0" version="0.0.0" fragment="true" unpack="false"/>
   <plugin id="dev.equo.ewt.evolve.cocoa.macosx.x86_64"
         os="macosx" ws="cocoa" arch="x86_64"
         download-size="0" install-size="0" version="0.0.0" fragment="true" unpack="false"/>
   <plugin id="dev.equo.ewt.evolve.cocoa.macosx.aarch64"
         os="macosx" ws="cocoa" arch="aarch64"
         download-size="0" install-size="0" version="0.0.0" fragment="true" unpack="false"/>

   <!-- The demo plugin with the showcase view (platform-independent). -->
   <plugin
         id="dev.equo.ewt.evolve.demo"
         download-size="0"
         install-size="0"
         version="0.0.0"
         unpack="false"/>

</feature>
